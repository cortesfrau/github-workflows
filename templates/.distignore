# Files and directories left out of the release zip.
# Syntax: rsync exclude patterns. A leading "/" anchors the pattern to the repo root;
# without it, the pattern matches at any depth, including inside vendor/.
# Keep patterns anchored unless you really mean "everywhere".
# Template: cortesfrau/github-workflows/templates/.distignore (plugins and themes)

# Git and CI
/.git/
/.github/
/.gitignore
/.gitattributes
/.distignore
/*.yml
/*.yaml

# Editor, agents and environment
/.vscode/
/.idea/
/.claude/
/.editorconfig
/.env
/.env.*

# Dependency manifests (vendor/ ships, its manifests and binaries do not)
/composer.json
/composer.lock
/auth.json
/package.json
/package-lock.json
/.nvmrc
/.npmrc
/node_modules/
/vendor/bin/

# Strauss: the pinned phar, its helper scripts and the dev-only class-alias shim.
# vendor-prefixed/ is NOT listed: it holds the prefixed dependencies and must ship.
# Both lines are no-ops in repos that don't use Strauss.
/tools/
/vendor/composer/autoload_aliases.php

# Quality tooling
/tests/
/phpunit.xml
/phpunit.xml.dist
/.phpunit.result.cache
/.phpunit.cache/
/phpstan.neon
/phpstan.neon.dist
/phpcs.xml
/phpcs.xml.dist
/.phpcs.xml
/.phpcs.xml.dist
/.php-cs-fixer.php
/.php-cs-fixer.dist.php
/.php-cs-fixer.cache
/.eslintrc*
/eslint.config.*
/.prettierrc*
/.stylelintrc*

# Build configuration
/vite.config.*
/webpack.config.*
/tsconfig.json
/postcss.config.*
/tailwind.config.*

# WordPress scaffolding and directory assets
/bin/
/.wordpress-org/

# Translations: WordPress only loads the compiled .mo, .l10n.php and .json files.
# .po and .pot are their sources. Keep them (delete these lines) if translations
# are edited on the site, e.g. with Loco Translate, which needs the .pot.
/languages/*.pot
/languages/*.po

# Docs: every Markdown file in the root (README, CHANGELOG, AGENTS, CLAUDE...).
# readme.txt and LICENSE files are kept on purpose: the "+ " rule re-includes a
# root LICENSE.md and must stay above "/*.md" (the first matching rule wins).
+ /LICENSE*
/*.md
/docs/
/plans/

# ---------------------------------------------------------------
# Project-specific. Uncomment or add what applies to this project.
# ---------------------------------------------------------------

# Front-end sources (SCSS/JS), when the build writes to another folder (e.g. dist/).
# Never exclude a folder that holds PHP loaded at runtime (e.g. PSR-4 classes in src/).
# /src/
# /assets/src/

# Plugin screenshots kept in the repo (themes need screenshot.png in the root: keep it)
# /screenshots/

# Source maps
# *.map
